{
  "dev-server-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/session-start.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "session-lifecycle": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/hooks/session-end.js",
        "timeout": 15
      }
    ]
  }
}
